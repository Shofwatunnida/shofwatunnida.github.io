  "contohLengkap": [
    {
      "id": "c1",
      "soal": "Berapa noktah pada gambar ke-8 pola segitiga?",
      "visual": { "jenis": "noktah", "bentuk": "segitiga", "banyak": 3 },
      "langkah": [
        { "label": "1. Amati", "teks": "Banyak noktah: 1, 3, 6, …" },
        { "label": "2. Cari lompatan", "teks": "+2, +3, … Selisihnya bertambah 1." },
        { "label": "3. Periksa", "teks": "Ini pola segitiga." },
        { "label": "4. Rumuskan", "teks": "Uₙ = n(n + 1)/2, jadi U₈ = 8 × 9 : 2 = 72 : 2 = **36**." },
        { "label": "5. Cek ulang", "teks": "Jumlahkan: 1 + 2 + 3 + 4 + 5 + 6 + 7 + 8 = 36 ✓." }
      ]
    },
    {
      "id": "c2",
      "soal": "Tentukan suku ke-12 pola segitiga 1, 3, 6, 10, …",
      "visual": { "jenis": "barisan", "pola": [1, 3, 6, 10] },
      "langkah": [
        { "label": "1. Amati", "teks": "Suku-sukunya 1, 3, 6, 10." },
        { "label": "2. Cari lompatan", "teks": "+2, +3, +4. Selisihnya bertambah 1." },
        { "label": "3. Periksa", "teks": "Ini pola segitiga, rumusnya Uₙ = n(n + 1)/2." },
        { "label": "4. Rumuskan", "teks": "U₁₂ = 12 × 13 : 2 = 156 : 2 = **78**." },
        { "label": "5. Cek ulang", "teks": "Cek rumus untuk n = 4: 4 × 5 : 2 = 10 ✓." }
      ]
    }
  ],
